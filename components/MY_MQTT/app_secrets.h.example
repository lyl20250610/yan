/* app_secrets.h.example — 本地凭据模板
 *
 * 用法（首次 clone 后必须做一次，否则编译会报 "app_secrets.h: No such file"）：
 *   Windows PowerShell:  Copy-Item app_secrets.h.example app_secrets.h
 *   macOS / Linux:       cp app_secrets.h.example app_secrets.h
 * 然后把下面的占位符换成你自己的值。
 *
 * 真实文件 app_secrets.h 已写入 .gitignore，不会被提交。
 * OneNET 的 DEVICE_KEY 属于敏感信息：拿到它即可为设备伪造 MQTT token 并连上你的项目，
 * 一旦不小心提交过，请立刻到 OneNET 控制台重置该设备密钥。
 */
#ifndef APP_SECRETS_H
#define APP_SECRETS_H

/* ---- Wi-Fi（2.4 GHz）---- */
#define WIFI_SSID        "YOUR_WIFI_SSID"
#define WIFI_PASSWORD    "YOUR_WIFI_PASSWORD"

/* ---- OneNET 物模型设备 ---- */
#define ONENET_PRODUCT_ID   "YOUR_PRODUCT_ID"
#define ONENET_DEVICE_NAME  "YOUR_DEVICE_NAME"
/* 设备密钥（Base64 形式） */
#define ONENET_DEVICE_KEY   "YOUR_BASE64_DEVICE_KEY"

#endif /* APP_SECRETS_H */
